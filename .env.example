# Keep credentials in this local file only. Do not commit a populated .env.
# Fal is used for all hosted processing: Demucs, depth, SAM 3, and Seedance.
FAL_KEY=
# Required on a Fly deployment. Generate a long random value and set it with
# `fly secrets set APP_ACCESS_TOKEN=...`; never commit it.
APP_ACCESS_TOKEN=

# Fal model configuration. Drafts use the lower-cost route. 1080p uses the
# standard route after an explicit approval in the UI.
FAL_DRAFT_MODEL=bytedance/seedance-2.0/fast/reference-to-video
FAL_DRAFT_RESOLUTION=720p
FAL_HD_MODEL=bytedance/seedance-2.0/reference-to-video
FAL_HD_RESOLUTION=1080p
